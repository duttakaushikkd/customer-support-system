# OpenAI (required)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
MODEL_MINI=gpt-4o-mini
MODEL_FLAGSHIP=gpt-4o
MODEL_EMBEDDING=text-embedding-3-small

# MongoDB Atlas
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/?retryWrites=true&w=majority&appName=Cluster-kd
MONGO_DB=customer_support

# Auth
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRE_MINUTES=480
EMAIL_INTAKE_WEBHOOK_SECRET=dev-webhook-secret
CRON_SECRET=dev-cron-secret

# Pipeline
MAX_TURNS=3
CONFIDENCE_FLOOR=0.5
RAG_CONFIDENCE_FLOOR=0.45

# Email (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=support@example.com
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
SUPPORT_MAILTO=support@example.com

# Frontend (empty = same origin on Vercel)
VITE_API_URL=

CORS_ORIGINS=*
