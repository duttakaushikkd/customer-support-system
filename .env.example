# OpenAI-compatible LLM (optional — placeholder key uses mock LLM)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=sk-replace-me
MODEL_MINI=gpt-4.1-mini
MODEL_FLAGSHIP=gpt-4.1
MODEL_EMBEDDING=text-embedding-3-small

# MongoDB Atlas (set the real URI in Vercel env / local .env — never commit secrets)
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/?retryWrites=true&w=majority&appName=Cluster-kd
MONGO_DB=customer_support

# Auth
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRE_MINUTES=480
EMAIL_INTAKE_WEBHOOK_SECRET=dev-webhook-secret
CRON_SECRET=dev-cron-secret

# Pipeline
MAX_TURNS=3
CONFIDENCE_FLOOR=0.5
RAG_CONFIDENCE_FLOOR=0.45

# Email (optional in production)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=support@example.com
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
BACKEND_URL=http://localhost:8000
SUPPORT_MAILTO=support@example.com

# Frontend on Vercel uses same-origin API (leave empty)
VITE_API_URL=

MOCK_LLM=false
CORS_ORIGINS=*
